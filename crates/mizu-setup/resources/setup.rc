#include <winver.h>

1 ICON "../../../assets/icons/mizu.ico"
1 24 "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,2,0
PRODUCTVERSION  0,1,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Onibi Lab"
            VALUE "FileDescription",  "Mizu Setup"
            VALUE "FileVersion",      "0.1.2"
            VALUE "InternalName",     "MizuSetup"
            VALUE "LegalCopyright",   "Onibi Lab. Licensed under MPL-2.0."
            VALUE "OriginalFilename", "MizuSetup.exe"
            VALUE "ProductName",      "Mizu"
            VALUE "ProductVersion",   "0.1.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
